<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.queue.QueueController"
            stylesheets="@dashboard.css"
            styleClass="window-navy"
            prefHeight="800" prefWidth="1200">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #2c3e50; -fx-padding: 12;">
            <Button text="← Back" onAction="#backToMenu" styleClass="btn-primary"/>

            <VBox alignment="CENTER_LEFT">
                <Label text="Queue (FIFO)" textFill="white">
                    <font><Font name="Arial Bold" size="28" /></font>
                </Label>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER" style="-fx-background-color: #34495e; -fx-padding: 5 15; -fx-background-radius: 5;">
                <Label text="Time Complexity" textFill="#95a5a6" style="-fx-font-size: 12;" />
                <Label fx:id="dynamicComplexityLabel" text="O(1)" textFill="#f1c40f" style="-fx-font-size: 18; -fx-font-weight: bold;" />
            </VBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox>
            <!-- Left Operations Panel -->
            <ScrollPane fitToWidth="true" prefWidth="250" styleClass="window-navy">
                <VBox spacing="0" styleClass="window-navy">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>

                    <!-- Initialization -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;">
                        <Label text="Initialization" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: white;"/>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Capacity:" style="-fx-font-size: 12; -fx-text-fill: #bdc3c7;"/>
                            <Spinner fx:id="capacitySpinner" prefWidth="70" editable="true"/>
                        </HBox>
                        <Button text="Create Empty Queue" onAction="#createQueue" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Generate Random" onAction="#generateRandom" maxWidth="Infinity" styleClass="btn-action"/>
                    </VBox>

                    <!-- Core Operations -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;">
                        <Label text="Core Operations" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: white;"/>
                        <TextField fx:id="valueInput" promptText="Enter Value" style="-fx-font-size: 12;"/>
                        
                        <Button text="Enqueue (Add)" onAction="#enqueue" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Dequeue (Remove)" onAction="#dequeue" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Peek (Front)" onAction="#peek" maxWidth="Infinity" styleClass="btn-action"/>        
                    </VBox>

                    <!-- Info/Checks -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;">
                        <Label text="Checks &amp; Info" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: white;"/>
                        <Button text="Is Empty?" onAction="#checkEmpty" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Is Full?" onAction="#checkFull" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Get Size" onAction="#getSize" maxWidth="Infinity" styleClass="btn-action"/>
                    </VBox>

                    <!-- Advanced -->
                    <VBox spacing="6" style="-fx-padding: 10;">
                        <Label text="Advanced" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: white;"/>
                        <Button text="Search Value" onAction="#search" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Traverse Queue" onAction="#traverse" maxWidth="Infinity" styleClass="btn-action"/>      
                        <Button text="Clear Queue" onAction="#clear" maxWidth="Infinity" styleClass="btn-action"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Right Side - Main Workspace -->
            <VBox HBox.hgrow="ALWAYS" styleClass="canvas-navy">
                
                <HBox VBox.vgrow="ALWAYS">
                    <!-- Visualization Area -->
                    <ScrollPane fitToHeight="true" fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background: #0f172a; -fx-background-color: transparent;">
                        <HBox alignment="CENTER" style="-fx-padding: 40; -fx-background-color: transparent;">
                            <VBox alignment="CENTER" spacing="10">
                                <Label text="QUEUE Base (Front → Rear)" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                                <!-- FlowPane naturally wraps left to right in case of overflow -->
                                <FlowPane fx:id="queueContainer" hgap="10" vgap="20" alignment="CENTER" prefWrapLength="800">
                                    <!-- Cells go here -->
                                </FlowPane>
                            </VBox>
                        </HBox>
                    </ScrollPane>

                    <!-- Step-by-Step Simulation Log Panel -->
                    <VBox prefWidth="300" minWidth="300" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-width: 0 0 0 2;">
                        <Label text="Simulation Steps" style="-fx-font-weight: bold; -fx-font-size: 15; -fx-text-fill: white; -fx-padding: 15; -fx-background-color: #0f172a;"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <VBox fx:id="stepLogContainer" spacing="10" style="-fx-padding: 15;">
                                <!-- Step messages go here -->
                            </VBox>
                        </ScrollPane>
                    </VBox>
                </HBox>

                <!-- Bottom Area: Message Output & Controls -->
                <HBox spacing="15" style="-fx-background-color: #0f172a; -fx-padding: 15; -fx-border-color: #334155; -fx-border-width: 2 0 0 0;" prefHeight="250" minHeight="250">
                    <!-- Result / Final Message Output -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="400">
                        <Label text="System Output:" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: white;"/>
                        <ScrollPane fitToWidth="true" style="-fx-background: #1e293b; -fx-border-color: #334155; -fx-border-radius: 3; -fx-background-radius: 3;" VBox.vgrow="ALWAYS">
                            <Label fx:id="outputLabel" text="Ready." wrapText="true" 
                                   style="-fx-font-family: 'Consolas'; -fx-font-size: 13; -fx-padding: 10; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- Playback & Speed Controls -->
                    <VBox spacing="15" prefWidth="400" minWidth="400" style="-fx-background-color: #1e293b; -fx-padding: 15; -fx-border-color: #334155; -fx-border-radius: 5; -fx-background-radius: 5;">
                        <Label text="Animation Controls" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;"/>
                        
                        <HBox alignment="CENTER" spacing="10">
                            <Button text="Reset" onAction="#resetAnimation" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;"/>
                            <Button text="Step Back" onAction="#stepBackward" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15; -fx-border-color: white; -fx-border-width: 1;"/>
                            <Button fx:id="playPauseBtn" text="Pause" onAction="#togglePlayPause" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;"/>
                            <Button text="Step Fwd" onAction="#stepForward" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15; -fx-border-color: white; -fx-border-width: 1;"/>
                        </HBox>

                        <VBox spacing="5" alignment="CENTER">
                            <Label text="Animation Speed" style="-fx-font-weight: bold; -fx-text-fill: #bdc3c7;"/>
                            <Slider fx:id="speedSlider" min="0.1" max="2.0" value="1.0" showTickMarks="true" showTickLabels="true" majorTickUnit="0.5" blockIncrement="0.1" prefWidth="250"/>
                        </VBox>
                    </VBox>
                </HBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
