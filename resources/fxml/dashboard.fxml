<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Polygon?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="900.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.AlgoVista.dashboard.DashboardController">

    <stylesheets>
        <URL value="@../css/dashboard.css" />
    </stylesheets>

    <!-- Main Content Layer -->
    <VBox spacing="0.0">
        <!-- Top Navigation Bar (Glassmorphism) -->
        <HBox alignment="CENTER_LEFT" prefHeight="76.0" spacing="20.0" styleClass="nav-bar">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            
            <!-- Hexagonal Logo Section -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <StackPane styleClass="logo-container-mini">
                    <Polygon fill="#0f172a" points="20.0, 0.0, 40.0, 11.5, 40.0, 34.5, 20.0, 46.0, 0.0, 34.5, 0.0, 11.5" stroke="#38bdf8" strokeWidth="2.0" />
                    <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-translate-y: -1;" text="A" textFill="WHITE" />
                </StackPane>
                <Label styleClass="nav-title" text="AlgoVista" />
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Secondary Navigation Area -->
            <HBox alignment="CENTER" spacing="30.0">
                <!-- Search Capsule Integrated in Nav -->
                <StackPane>
                    <TextField fx:id="searchField" maxWidth="220.0" onKeyReleased="#onSearch" prefHeight="38.0" promptText="Search..." styleClass="search-field" />
                </StackPane>
                
                <Label styleClass="nav-link-active" text="HOME" />
                <Label onMouseClicked="#onSettings" styleClass="nav-link" text="SETTINGS" />
                <Label onMouseClicked="#onAbout" styleClass="nav-link" text="ABOUT US" />
            </HBox>
        </HBox>

        <!-- Library Grid (Full Focus) -->
        <VBox alignment="CENTER" spacing="0.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="40.0" />
            </padding>
            
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="50.0" left="80.0" right="80.0" />
                </padding>
                <VBox alignment="TOP_CENTER" spacing="35.0">
                    <!-- SECTION 1: LINEAR DATA STRUCTURES -->
                    <VBox fx:id="linearSection" spacing="10.0">
                        <HBox alignment="CENTER" spacing="15.0">
                            <Region styleClass="section-line" HBox.hgrow="ALWAYS" />
                            <Label styleClass="section-header" text="LINEAR DATA STRUCTURES" />
                            <Region styleClass="section-line" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <TilePane fx:id="linearContainer" alignment="TOP_CENTER" hgap="35.0" prefColumns="4" vgap="20.0" />
                    </VBox>

                    <!-- SECTION 2: GRAPH & TREE STRUCTURES -->
                    <VBox fx:id="graphSection" spacing="10.0">
                        <HBox alignment="CENTER" spacing="15.0">
                            <Region styleClass="section-line" HBox.hgrow="ALWAYS" />
                            <Label styleClass="section-header" text="GRAPH &amp; TREE STRUCTURES" />
                            <Region styleClass="section-line" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <TilePane fx:id="graphContainer" alignment="TOP_CENTER" hgap="35.0" prefColumns="4" vgap="20.0" />
                    </VBox>

                    <!-- SECTION 3: CORE ALGORITHMS -->
                    <VBox fx:id="algoSection" spacing="10.0">
                        <HBox alignment="CENTER" spacing="15.0">
                            <Region styleClass="section-line" HBox.hgrow="ALWAYS" />
                            <Label styleClass="section-header" text="CORE ALGORITHMS" />
                            <Region styleClass="section-line" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <TilePane fx:id="algoSectionContainer" alignment="TOP_CENTER" hgap="35.0" prefColumns="4" vgap="20.0" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </VBox>

                <!-- Overlay Layer (Initially Hidden) -->
    <StackPane fx:id="overlayPane" mouseTransparent="true" opacity="0" styleClass="overlay-dim">
        <VBox fx:id="modalContent" alignment="CENTER" maxHeight="650.0" maxWidth="1000.0" styleClass="modal-panel">
            <!-- Dynamic Content Injected Here via Controller -->
        </VBox>
    </StackPane>
</StackPane>
