<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="900.0" 
           styleClass="dashboard-root"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.AlgoVista.dashboard.DashboardController">

    <stylesheets>
        <URL value="@../css/dashboard.css" />
    </stylesheets>

    <!-- Main Content Layer -->
    <VBox spacing="0.0">
        <!-- Top Navigation Bar (Glassmorphism) -->
        <HBox alignment="CENTER_LEFT" prefHeight="76.0" spacing="20.0" styleClass="nav-bar">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <StackPane styleClass="logo-mini">
                    <Circle radius="18" fill="#0f172a" stroke="#38bdf8" strokeWidth="1.5" />
                    <Label text="AV" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                </StackPane>
                <Label text="AlgoVista" styleClass="nav-title" />
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox alignment="CENTER" spacing="35.0">
                <Label text="HOME" styleClass="nav-link-active" />
                <Label text="SETTINGS" styleClass="nav-link" onMouseClicked="#onSettings" />
                <Label text="ABOUT" styleClass="nav-link" onMouseClicked="#onAbout" />
            </HBox>
        </HBox>

        <!-- Centered Header & Search -->
        <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="50.0" bottom="20.0" />
            </padding>
            
            <VBox alignment="CENTER" spacing="10.0">
                <Label text="Algorithm Library" styleClass="header-title" />
                <Label text="MASTER THE LOGIC THROUGH VISUALIZATION" styleClass="header-subtitle" />
            </VBox>
            
            <!-- Premium Search Capsule -->
            <StackPane maxWidth="550.0" styleClass="search-container">
                <TextField fx:id="searchField" onKeyReleased="#onSearch" 
                           promptText="Search algorithms (BFS, Dijkstra, Puzzles...)" 
                           styleClass="search-field" />
            </StackPane>

            <!-- Library Content -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets left="40.0" right="40.0" top="30.0" bottom="50.0" />
                </padding>
                <TilePane fx:id="algoContainer" alignment="TOP_CENTER" hgap="35.0" prefColumns="3" vgap="35.0" />
            </ScrollPane>
        </VBox>
    </VBox>

    <!-- Overlay Layer (Initially Hidden) -->
    <StackPane fx:id="overlayPane" mouseTransparent="true" opacity="0" styleClass="overlay-dim">
        <VBox fx:id="modalContent" alignment="CENTER" maxWidth="600.0" maxHeight="450.0" styleClass="modal-panel">
            <!-- Dynamic Content Injected Here via Controller -->
        </VBox>
    </StackPane>
</StackPane>