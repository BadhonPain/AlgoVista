<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.array.ArrayController"
            stylesheets="@dashboard.css"
            styleClass="window-navy"
            prefHeight="800" prefWidth="1200">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #2c3e50; -fx-padding: 12;">
            <Button text="← Back" onAction="#backToMenu" styleClass="btn-primary"/>

            <VBox alignment="CENTER_LEFT">
                <Label text="Array" textFill="white">
                    <font><Font name="Arial Bold" size="28" /></font>
                </Label>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox alignment="CENTER" style="-fx-background-color: #2c3e50; -fx-padding: 5 15; -fx-background-radius: 5; -fx-border-color: #f39c12; -fx-border-radius: 5; -fx-border-width: 2;">
                <Label fx:id="dynamicComplexityLabel" text="Time Complexity: O(1)" styleClass="text-primary" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16;"/>
            </HBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox>
            <!-- Left Operations Panel -->
            <ScrollPane fitToWidth="true" prefWidth="250" styleClass="window-navy">
                <VBox spacing="0" styleClass="window-navy">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>

                    <!-- Generate List -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;">
                        <Label text="Initialization" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;"/>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Size:" style="-fx-font-size: 13; -fx-text-fill: #bdc3c7;"/>
                            <Spinner fx:id="sizeSpinner" prefWidth="60" editable="true"/>
                        </HBox>
                        <Button text="Create Empty Array" onAction="#createArray" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Generate Random Array" onAction="#generateRandom" maxWidth="Infinity" styleClass="btn-action"/>
                    </VBox>

                    <!-- Insertion Operations -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;">
                        <Label text="Modifiers" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;"/>
                        <TextField fx:id="valueInput" promptText="Enter Value" style="-fx-font-size: 14;"/>
                        <TextField fx:id="indexInput" promptText="Enter Index" style="-fx-font-size: 14;"/>
                        
                        <Button text="Insert at End" onAction="#insertAtEnd" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Insert at Index" onAction="#insertAtIndex" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Update Value" onAction="#updateValue" maxWidth="Infinity" styleClass="btn-action"/>        
                    </VBox>

                    <!-- Deletion Operations -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #2c3e50; -fx-border-width: 0 0 2 0;">
                        <Label text="Deletion" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;"/>
                        <Button text="Delete by Value" onAction="#deleteByValue" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Delete at Index" onAction="#deleteAtIndex" maxWidth="Infinity" styleClass="btn-action"/>
                    </VBox>

                    <!-- Other Operations -->
                    <VBox spacing="6" style="-fx-padding: 10;">
                        <Label text="Operations" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;"/>
                        <Button text="Search Value" onAction="#search" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Traverse" onAction="#traverse" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Reverse" onAction="#reverse" maxWidth="Infinity" styleClass="btn-action"/>
                        <Button text="Sort (Bubble)" onAction="#sort" maxWidth="Infinity" styleClass="btn-action"/>        
                        <Button text="Clear Array" onAction="#clear" maxWidth="Infinity" styleClass="btn-action"/>
                    </VBox>
                    


                </VBox>
            </ScrollPane>

            <!-- Right Side - Visualization Area -->
            <VBox HBox.hgrow="ALWAYS" styleClass="canvas-navy">
                
                <HBox VBox.vgrow="ALWAYS">
                    <!-- Visualization Output -->
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-background: #0f172a; -fx-background-color: transparent;">
                            <VBox alignment="CENTER" style="-fx-padding: 40;">
                                <FlowPane fx:id="arrayContainer" hgap="4" vgap="15" alignment="CENTER" prefWrapLength="800">
                                    <!-- Array cells will be generated here -->
                                </FlowPane>
                            </VBox>
                        </ScrollPane>

                        <!-- Legend -->
                        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 20; -fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-width: 1 0 0 0;">
                            <HBox alignment="CENTER" spacing="5"><Region prefWidth="15" prefHeight="15" style="-fx-background-color: #9b59b6;"/><Label text="Default" style="-fx-text-fill: white;"/></HBox>
                            <HBox alignment="CENTER" spacing="5"><Region prefWidth="15" prefHeight="15" style="-fx-background-color: #f1c40f;"/><Label text="Traversing/Searching" style="-fx-text-fill: white;"/></HBox>
                            <HBox alignment="CENTER" spacing="5"><Region prefWidth="15" prefHeight="15" style="-fx-background-color: #2ecc71;"/><Label text="Success/Sorted/Inserted" style="-fx-text-fill: white;"/></HBox>
                            <HBox alignment="CENTER" spacing="5"><Region prefWidth="15" prefHeight="15" style="-fx-background-color: #3498db;"/><Label text="Comparing/Update" style="-fx-text-fill: white;"/></HBox>
                            <HBox alignment="CENTER" spacing="5"><Region prefWidth="15" prefHeight="15" style="-fx-background-color: #e74c3c;"/><Label text="Swapping/Removing" style="-fx-text-fill: white;"/></HBox>
                            <HBox alignment="CENTER" spacing="5"><Region prefWidth="15" prefHeight="15" style="-fx-background-color: #e67e22;"/><Label text="Reversing" style="-fx-text-fill: white;"/></HBox>
                        </HBox>
                    </VBox>

                    <!-- Step-by-Step Simulation Log Panel -->
                    <VBox prefWidth="320" minWidth="320" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-width: 0 0 0 2;">
                        <Label text="Simulation Steps" style="-fx-font-weight: bold; -fx-font-size: 19; -fx-text-fill: white; -fx-padding: 15; -fx-background-color: #0f172a;"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <VBox fx:id="stepLogContainer" spacing="12" style="-fx-padding: 15;">
                                <!-- Step messages go here -->
                            </VBox>
                        </ScrollPane>
                    </VBox>
                </HBox>
                
                <!-- Bottom Area: Message Output & Complexities -->
                <HBox spacing="15" style="-fx-background-color: #0f172a; -fx-padding: 15; -fx-border-color: #334155; -fx-border-width: 2 0 0 0;" prefHeight="250" minHeight="250">
                    <!-- Result / Message Output -->
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="System Output:" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;"/>
                        <ScrollPane fitToWidth="true" style="-fx-background: #1e293b; -fx-border-color: #334155; -fx-border-radius: 3; -fx-background-radius: 3;" VBox.vgrow="ALWAYS">
                            <Label fx:id="outputLabel" text="Array Visualizer initialized." wrapText="true" 
                                   style="-fx-font-family: 'Consolas'; -fx-font-size: 15; -fx-padding: 10; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </ScrollPane>
                    </VBox>
                    
                    <!-- Advanced Controls (Moved from Left Side) -->
                    <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #2c3e50; -fx-border-width: 2; -fx-background-color: #0f172a; -fx-border-radius: 5; -fx-background-radius: 5;" prefWidth="300" minWidth="300">
                        <Label text="Animation Control" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;"/>
                        
                        <VBox spacing="5">
                            <Label text="Animation Speed" style="-fx-font-size: 13; -fx-text-fill: #bdc3c7;"/>
                            <Slider fx:id="speedSlider" min="0.1" max="5.0" value="1.0" 
                                    showTickMarks="true" showTickLabels="false" majorTickUnit="1.0"/>
                        </VBox>

                        <HBox spacing="5" alignment="CENTER">
                            <Button text="⏮" onAction="#stepBack" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8; -fx-border-color: white; -fx-border-width: 1;"/>
                            <Button fx:id="playPauseBtn" text="⏸" onAction="#togglePlayPause" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8;"/>
                            <Button text="⏭" onAction="#stepForward" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8; -fx-border-color: white; -fx-border-width: 1;"/>
                        </HBox>
                        <Button text="⏹ Reset" onAction="#resetAnimation" maxWidth="Infinity"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8;"/>
                    </VBox>

                </HBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
