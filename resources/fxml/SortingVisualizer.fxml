<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.AlgoVista.sorting.SortingVisualizerController" stylesheets="@dashboard.css" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #1e293b;">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #0f172a; -fx-padding: 15;">
                <Button onAction="#backToMenu" styleClass="btn-primary" text="← Back" />
                <Label fx:id="algoTitleLabel" text="Algorithm Visualizer" styleClass="text-white" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Language:" styleClass="text-muted" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <HBox spacing="10">
                    <Label text="C++" styleClass="language-label, active" onMouseClicked="#setLanguageCpp"/>
                    <Label text="Java" styleClass="language-label" onMouseClicked="#setLanguageJava"/>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <Label fx:id="complexityLabel" text="Time Complexity: O(n²)" styleClass="text-primary" style="-fx-font-weight: bold; -fx-text-fill: white;"/>

                <TextField fx:id="customArrayInput" promptText="e.g. 5,12,3" prefWidth="100" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 5;"/>
                <Button text="Set Array" onAction="#setCustomArray" styleClass="btn-primary" style="-fx-background-color: #10b981;"/>

                <Button text="Random Array" onAction="#generateArray" styleClass="btn-primary"/>
                <Label text="Speed:" styleClass="text-muted" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <Slider fx:id="speedSlider" min="0.25" max="2.0" value="1.0" prefWidth="80"/>

                <HBox spacing="5">
                    <Button text="I&lt;" onAction="#stepBackward" styleClass="btn-icon"/>
                    <Button fx:id="playPauseBtn" text="▶" onAction="#playPause" styleClass="btn-icon"/>
                    <Button text="&gt;I" onAction="#stepForward" styleClass="btn-icon"/>
                    <Button text="⟲" onAction="#reset" styleClass="btn-icon"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Visualization Area -->
            <VBox styleClass="viz-container" VBox.vgrow="ALWAYS" alignment="CENTER" style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-border-width: 2;">
                <!-- Height set properly via CSS/code -->
                <HBox fx:id="arrayContainer" alignment="BOTTOM_CENTER" spacing="15" prefHeight="300"/>
            </VBox>
            
            <!-- Code and Variables -->
            <HBox spacing="20" VBox.vgrow="SOMETIMES" prefHeight="250">
                <VBox styleClass="code-box" HBox.hgrow="ALWAYS" style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 0;">
                    <Label text="DRY RUN" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-color: #1e293b; -fx-background-radius: 10 10 0 0;" maxWidth="Infinity"/>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="codeContainer" spacing="2" style="-fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
                
                <VBox styleClass="variables-box" prefWidth="300" style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 0;">
                    <Label text="VARIABLES" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-color: #1e293b; -fx-background-radius: 10 10 0 0;" maxWidth="Infinity"/>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="variablesContainer" spacing="5" style="-fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" style="-fx-background-color: #10b981; -fx-padding: 15;">
            <Label fx:id="statusLabel" text="Algorithm Ready..." style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
    </bottom>
</BorderPane>
