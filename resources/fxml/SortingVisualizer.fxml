<?xml version="1.0" encoding="UTF-8"?>



<?import javafx.scene.control.*?>

<?import javafx.scene.layout.*?>



<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.AlgoVista.sorting.SortingVisualizerController" stylesheets="@dashboard.css" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #1e293b;">

    <top>

        <VBox>

            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #0f172a; -fx-padding: 15;">

                <Button onAction="#backToMenu" styleClass="btn-primary" text="← Back" />

                <Label fx:id="algoTitleLabel" text="Algorithm Visualizer" styleClass="text-white" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Region HBox.hgrow="ALWAYS" />

                

                <Label fx:id="complexityLabel" text="Time Complexity: O(n²)" styleClass="text-primary" style="-fx-font-weight: bold; -fx-text-fill: white;"/>



                <TextField fx:id="customArrayInput" promptText="e.g. 5,12,3" prefWidth="250" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 16px;"/>

                <Button text="Set Array" onAction="#setCustomArray" styleClass="btn-primary" />



                <Button text="Random Array" onAction="#generateArray" styleClass="btn-primary"/>

                <Label text="Speed:" styleClass="text-muted" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16px;"/>

                <Slider fx:id="speedSlider" min="0.25" max="2.0" value="1.0" prefWidth="120"/>



                <HBox spacing="10">

                    <Button text="◀ Prev" onAction="#stepBackward" styleClass="btn-playback"/>

                    <Button fx:id="playPauseBtn" text="▶ Play" onAction="#playPause" styleClass="btn-playback-play"/>

                    <Button text="Next ▶" onAction="#stepForward" styleClass="btn-playback"/>

                    <Button text="⟲ Reset" onAction="#reset" styleClass="btn-playback"/>

                </HBox>

            </HBox>

        </VBox>

    </top>



    <center>

        <VBox spacing="20" style="-fx-padding: 20;">

            

            <VBox styleClass="viz-container" VBox.vgrow="ALWAYS" alignment="CENTER" style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-border-width: 2;">

                

                <HBox fx:id="arrayContainer" alignment="BOTTOM_CENTER" spacing="15" prefHeight="300"/>

            </VBox>

            

            

            <HBox alignment="CENTER" spacing="25" style="-fx-background-color: #0f172a; -fx-padding: 10; -fx-background-radius: 5;">

                <HBox alignment="CENTER" spacing="8">

                    <Region style="-fx-background-color: #3498db; -fx-min-width: 15; -fx-min-height: 15; -fx-background-radius: 2;"/>

                    <Label text="Default" style="-fx-text-fill: white; -fx-font-weight: bold;"/>

                </HBox>

                <HBox alignment="CENTER" spacing="8">

                    <Region style="-fx-background-color: #e74c3c; -fx-min-width: 15; -fx-min-height: 15; -fx-background-radius: 2;"/>

                    <Label text="Comparing/Active" style="-fx-text-fill: white; -fx-font-weight: bold;"/>

                </HBox>

                <HBox alignment="CENTER" spacing="8">

                    <Region style="-fx-background-color: #2ecc71; -fx-min-width: 15; -fx-min-height: 15; -fx-background-radius: 2;"/>

                    <Label text="Sorted" style="-fx-text-fill: white; -fx-font-weight: bold;"/>

                </HBox>

            </HBox>

            

            

            <HBox spacing="20" VBox.vgrow="SOMETIMES" prefHeight="250">

                <VBox styleClass="code-box" HBox.hgrow="ALWAYS" style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 0;">

                    <Label text="DRY RUN" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-color: #1e293b; -fx-background-radius: 10 10 0 0;" maxWidth="Infinity"/>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 10;" VBox.vgrow="ALWAYS">

                        <VBox fx:id="codeContainer" spacing="2" style="-fx-background-color: transparent;"/>

                    </ScrollPane>

                </VBox>

            </HBox>

        </VBox>

    </center>



    <bottom>

        <VBox alignment="CENTER" style="-fx-background-color: #0f172a; -fx-padding: 15; -fx-border-color: #334155; -fx-border-width: 2 0 0 0;">

            <Label fx:id="statusLabel" text="Algorithm Ready..." style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #38bdf8;"/>

        </VBox>

    </bottom>

</BorderPane>



