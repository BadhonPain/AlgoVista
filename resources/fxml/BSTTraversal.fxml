<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.bst.BSTTraversalController"
            style="-fx-background-color: #f5f5f5;"
            prefHeight="800" prefWidth="1200">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #2c3e50; -fx-padding: 12;">
            <Button text="← Back to Category" onAction="#backToCategory"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;
                           -fx-background-radius: 5; -fx-padding: 8 15; -fx-cursor: hand;
                           -fx-font-weight: bold;"/>

            <Label text="BST - TRAVERSALS" textFill="white">
                <font><Font name="Arial" size="24" /></font>
            </Label>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox>
            <!-- Left Operations Panel (Scrollable) -->
            <ScrollPane fitToWidth="true" prefWidth="250"
                        style="-fx-background: #81ecec; -fx-background-color: #81ecec;">
                <VBox spacing="0" style="-fx-background-color: #81ecec;">

                    <!-- Random Generation for Traversals (simplified) -->
                    <VBox spacing="8" style="-fx-padding: 12; -fx-border-color: #00cec9;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="Setup Tree for Traversal"
                               style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Nodes:" style="-fx-font-size: 11;"/>
                            <Spinner fx:id="sizeSpinner" prefWidth="60" editable="true"/>
                        </HBox>
                        <Button text="Generate Random Tree" onAction="#generateRandomBST" maxWidth="Infinity"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-padding: 8;"/>
                        <Label text="or" style="-fx-font-size: 10; -fx-text-fill: #555; -fx-alignment: center;" maxWidth="Infinity"/>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <TextField fx:id="valueInput" promptText="Enter Value" style="-fx-font-size: 11;"/>
                            <Button text="Add" onAction="#insertValue"
                                    style="-fx-background-color: #0984e3; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;"/>
                        </HBox>
                        <Label text="or" style="-fx-font-size: 10; -fx-text-fill: #555; -fx-alignment: center;" maxWidth="Infinity"/>
                        <TextField fx:id="customBSTInput" promptText="e.g. 50,25,75" style="-fx-font-size: 11;"/>
                        <Button text="Build Array" onAction="#buildCustomBST" maxWidth="Infinity"
                                style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-padding: 8;"/>
                        <Label text="or" style="-fx-font-size: 10; -fx-text-fill: #555; -fx-alignment: center;" maxWidth="Infinity"/>
                        <Button text="Clear Tree" onAction="#clearTree" maxWidth="Infinity"
                                style="-fx-background-color: #2d3436; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-padding: 8;"/>
                    </VBox>

                    <!-- Traversals -->
                    <VBox spacing="8" style="-fx-padding: 12; -fx-border-color: #00cec9;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="Traversals - O(n)"
                               style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <Button text="In-order Traversal" onAction="#inorderTraversal" maxWidth="Infinity"
                                style="-fx-background-color: #6c5ce7; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-padding: 8;"/>
                        <Button text="Pre-order Traversal" onAction="#preorderTraversal" maxWidth="Infinity"
                                style="-fx-background-color: #e84393; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-padding: 8;"/>
                        <Button text="Post-order Traversal" onAction="#postorderTraversal" maxWidth="Infinity"
                                style="-fx-background-color: #fdcb6e; -fx-text-fill: black;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-padding: 8;"/>
                        <Button text="Level-order Traversal" onAction="#levelOrderTraversal" maxWidth="Infinity"
                                style="-fx-background-color: #00b894; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-padding: 8;"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Right Side - Visualization -->
            <VBox spacing="0" HBox.hgrow="ALWAYS">

                <!-- Canvas Area inside ScrollPane for panning/zooming -->
                <ScrollPane fx:id="canvasScrollPane" pannable="true" fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: #1E1E1E; -fx-background: #1E1E1E;">
                    <StackPane style="-fx-background-color: #1E1E1E;">
                        <Canvas fx:id="bstCanvas" width="930" height="500"/>
                    </StackPane>
                </ScrollPane>

                <!-- Traversal Output Area -->
                <VBox spacing="6" style="-fx-background-color: #ecf0f1; -fx-padding: 12;"
                      prefHeight="230">
                    
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Traversal Route / History"
                               style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;"/>
                    </HBox>
                    <ScrollPane fitToHeight="true" prefHeight="85"
                                style="-fx-background: white; -fx-background-color: white;
                      -fx-border-color: #2c3e50; -fx-border-width: 2;">
                        <HBox fx:id="traversalBox" spacing="8" style="-fx-padding: 8; -fx-alignment: CENTER_LEFT;"/>
                    </ScrollPane>

                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                        <Label text="Queue Simulation (Level-Order)"
                               style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;"/>
                    </HBox>
                    <ScrollPane fitToHeight="true" prefHeight="85"
                                style="-fx-background: white; -fx-background-color: white;
                      -fx-border-color: #e67e22; -fx-border-width: 2;">
                        <HBox fx:id="queueBox" spacing="8" style="-fx-padding: 8; -fx-alignment: CENTER_LEFT;"/>
                    </ScrollPane>

                </VBox>

            </VBox>
        </HBox>
    </center>

    <!-- Bottom Control Bar (Compact) -->
    <bottom>
        <VBox spacing="0" style="-fx-background-color: #2c3e50;" prefHeight="80">

            <!-- Animation Controls -->
            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8;">

                <Label text="Speed:" textFill="white" style="-fx-font-weight: bold; -fx-font-size: 12;"/>

                <Label text="0.5x" textFill="#bdc3c7" style="-fx-font-size: 11;"/>
                <Slider fx:id="speedSlider" min="0.5" max="5" value="1.5"
                        prefWidth="150" showTickMarks="false"/>
                <Label text="5x" textFill="#bdc3c7" style="-fx-font-size: 11;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="playButton" text="▶ Play" onAction="#playAnimation"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 6 15; -fx-cursor: hand;
                               -fx-font-size: 12;"/>

                <Button fx:id="pauseButton" text="⏸ Pause" onAction="#pauseAnimation"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 6 15; -fx-cursor: hand;
                               -fx-font-size: 12;"/>

                <Button fx:id="stepButton" text="Step ▶" onAction="#nextStep"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 6 15; -fx-cursor: hand;
                               -fx-font-size: 12;"/>
            </HBox>

            <!-- Status Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color: #34495e; -fx-padding: 6 12;">
                <Label fx:id="statusLabel" text="Ready" textFill="white"
                       style="-fx-font-size: 14;"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>
