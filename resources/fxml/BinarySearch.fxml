<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20.0"
      style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b); -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.AlgoVista.dnc.BinarySearchController">
    <children>
        <!-- Top Bar -->
        <BorderPane>
            <left>
                <Button text="← Back" onAction="#backToCategory"
                        style="-fx-background-color: rgba(56, 189, 248, 0.1);
                               -fx-text-fill: #38bdf8;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-padding: 8 20 8 20;
                               -fx-background-radius: 20;
                               -fx-border-color: rgba(56, 189, 248, 0.5);
                               -fx-cursor: hand;" />
            </left>
            <center>
                <Label text="Binary Search" textFill="#38bdf8">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </center>
            <right>
                <Region prefWidth="100.0" />
            </right>
        </BorderPane>

        <!-- Array Visualization Area -->
        <StackPane VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" spacing="50.0">
                <HBox fx:id="arrayContainer" alignment="CENTER" spacing="10.0" />
                
                <VBox alignment="CENTER" spacing="10.0">
                    <Label fx:id="statusLabel" text="Enter a target and click Search" textFill="#94a3b8">
                        <font>
                            <Font size="18.0" />
                        </font>
                    </Label>
                    <Label fx:id="complexityLabel" text="Complexity: O(log n)" visible="false"
                           style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-text-fill: #3498db; -fx-padding: 3 15 3 15; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 13;" />
                    <Label fx:id="stepLabel" text="Step Details" textFill="#38bdf8" wrapText="true" maxWidth="600.0" textAlignment="CENTER">
                        <font>
                            <Font name="System Italic" size="14.0" />
                        </font>
                    </Label>
                </VBox>
            </VBox>
        </StackPane>

        <!-- View Controls (Inputs and Actions) -->
        <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: rgba(30, 41, 59, 0.7); -fx-padding: 25; -fx-background-radius: 20; -fx-border-color: rgba(56, 189, 248, 0.3); -fx-border-width: 1;">
            <VBox spacing="10.0">
                <Label text="SEARCH TARGET" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10;" />
                <TextField fx:id="targetInput" prefWidth="120.0" promptText="e.g. 42"
                           style="-fx-background-color: #334155; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 14;" />
            </VBox>

            <VBox spacing="10.0">
                <Label text="CUSTOM ARRAY (COMMA SEPARATED)" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10;" />
                <HBox spacing="10.0">
                    <TextField fx:id="customArrayInput" prefWidth="250.0" promptText="e.g. 10, 20, 35, 50"
                               style="-fx-background-color: #334155; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 14;" />
                    <Button text="Create" onAction="#handleCustomArray"
                            style="-fx-background-color: linear-gradient(to bottom, #38bdf8, #0284c7); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 8 15; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.4), 10, 0, 0, 2);" />
                </HBox>
            </VBox>

            <VBox alignment="BOTTOM_CENTER" spacing="10.0">
                <HBox spacing="15.0">
                    <Button text="Start Search" onAction="#startSearch"
                            style="-fx-background-color: linear-gradient(to bottom, #10b981, #059669); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 25; -fx-font-size: 14; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.4), 10, 0, 0, 2);" />
                    <Button text="Reset" onAction="#resetSearch"
                            style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: #ef4444; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 8 20; -fx-font-weight: bold;" />
                </HBox>
            </VBox>
        </HBox>
    </children>
</VBox>
