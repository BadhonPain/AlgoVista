<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20.0"
      style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b); -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.AlgoVista.dnc.QuickSortController">
    <children>
        <!-- Top Bar -->
        <BorderPane>
            <left>
                <Button text="← Back" onAction="#backToCategory"
                        style="-fx-background-color: rgba(243, 156, 18, 0.1);
                               -fx-text-fill: #f39c12;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-padding: 8 20 8 20;
                               -fx-background-radius: 20;
                               -fx-border-color: rgba(243, 156, 18, 0.5);
                               -fx-cursor: hand;" />
            </left>
            <center>
                <Label text="Quick Sort" textFill="#f39c12">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </center>
            <right>
                <Region prefWidth="100.0" />
            </right>
        </BorderPane>

        <!-- Array Visualization Area (Vertical Trace) -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                  style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                  VBox.vgrow="ALWAYS">
            <VBox fx:id="treeContainer" alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 30;">
                <!-- Rows will be added dynamically here -->
            </VBox>
        </ScrollPane>

        <VBox alignment="CENTER" spacing="5.0">
            <Label fx:id="statusLabel" text="Click Start Quick Sort to begin!" textFill="#94a3b8">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
            <Label fx:id="complexityLabel" text="Complexity: O(n log n)" visible="false"
                   style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-text-fill: #3498db; -fx-padding: 3 15 3 15; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 13;" />
            
            <Label fx:id="stepLabel" text="Step Details" textFill="#f39c12" wrapText="true" maxWidth="600.0" textAlignment="CENTER">
                <font>
                    <Font name="System Italic" size="14.0" />
                </font>
            </Label>
        </VBox>

        <!-- View Controls -->
        <HBox alignment="CENTER" spacing="25.0" style="-fx-background-color: rgba(30, 41, 59, 0.7); -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: rgba(243, 156, 18, 0.3);">
            <VBox spacing="8.0">
                <Label text="CUSTOM ARRAY" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10;" />
                <HBox spacing="10.0">
                    <TextField fx:id="customArrayInput" prefWidth="200.0" promptText="5, 2, 8, 1, 9"
                               style="-fx-background-color: #334155; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8;" />
                    <Button text="Create" onAction="#handleCustomArray"
                            style="-fx-background-color: linear-gradient(to bottom, #f39c12, #e67e22); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" />
                </HBox>
            </VBox>

            <VBox spacing="8.0">
                <Label text="PIVOT STRATEGY" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10;" />
                <ComboBox fx:id="pivotSelector" prefWidth="120.0" 
                          style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 8;" />
            </VBox>
            
            <HBox alignment="BOTTOM_CENTER" spacing="15.0">
                <Button text="Start Quick Sort" onAction="#startSort"
                        style="-fx-background-color: linear-gradient(to bottom, #2ecc71, #27ae60); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 25;" />
                <Button text="Reset" onAction="#generateNewArray"
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: #ef4444; -fx-border-radius: 8; -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </children>
</VBox>
