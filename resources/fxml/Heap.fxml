<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.heap.heapController"
            style="-fx-background-color: #f5f5f5;"
            prefHeight="800" prefWidth="1200">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #2c3e50; -fx-padding: 12;">
            <Button text="← Back" onAction="#backToDashboard"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;
                           -fx-background-radius: 5; -fx-padding: 8 15; -fx-cursor: hand;
                           -fx-font-weight: bold;"/>

            <Label text="BINARY HEAP" textFill="white">
                <font><Font name="Arial" size="24" /></font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Heap Type Toggle -->
            <HBox spacing="10" alignment="CENTER">
                <RadioButton fx:id="rbMaxHeap" text="Max Heap" textFill="white"
                             style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                <RadioButton fx:id="rbMinHeap" text="Min Heap" textFill="white"
                             style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <HBox>
            <!-- Left Operations Panel (Scrollable) -->
            <ScrollPane fitToWidth="true" prefWidth="240"
                        style="-fx-background: #f9d342; -fx-background-color: #f9d342;">
                <VBox spacing="0" style="-fx-background-color: #f9d342;">

                    <!-- Create O(n log n) -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #d4b830;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="Create(A) - O(n log n)"
                               style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Size:" style="-fx-font-size: 10;"/>
                            <Spinner fx:id="sizeSpinner" prefWidth="60" editable="true"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Range:" style="-fx-font-size: 10;"/>
                            <Spinner fx:id="minSpinner" prefWidth="45" editable="true"/>
                            <Label text="-" style="-fx-font-size: 10;"/>
                            <Spinner fx:id="maxSpinner" prefWidth="45" editable="true"/>
                        </HBox>
                        <Button text="Generate" onAction="#buildHeapNlogN" maxWidth="Infinity"
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                    <!-- Create O(n) -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #d4b830;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="Create(A) - O(n)"
                               style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <Label text="(Uses settings above)"
                               style="-fx-font-size: 9; -fx-text-fill: #666;"/>
                        <Button text="Generate Optimal" onAction="#buildHeapN" maxWidth="Infinity"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                    <!-- Insert -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #d4b830;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="Insert(v) - O(log n)"
                               style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <TextField fx:id="valueInput" promptText="Value"
                                   style="-fx-font-size: 11;"/>
                        <Button text="Insert" onAction="#insertValue" maxWidth="Infinity"
                                style="-fx-background-color: #3498db; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                    <!-- Extract -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #d4b830;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="ExtractMax/Min() - O(log n)"
                               style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <Button text="Extract Root" onAction="#extractRoot" maxWidth="Infinity"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                    <!-- Heap Sort -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #d4b830;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="HeapSort() - O(n log n)"
                               style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <Button text="Heap Sort" onAction="#heapSort" maxWidth="Infinity"
                                style="-fx-background-color: #9b59b6; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                    <!-- Update Key -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #d4b830;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="UpdateKey(i, newv) - O(log n)"
                               style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <TextField fx:id="indexInput" promptText="Index"
                                   style="-fx-font-size: 11;"/>
                        <TextField fx:id="newValueInput" promptText="New Value"
                                   style="-fx-font-size: 11;"/>
                        <Button text="Update Key" onAction="#updateKey" maxWidth="Infinity"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                    <!-- Delete -->
                    <VBox spacing="6" style="-fx-padding: 10; -fx-border-color: #d4b830;
                                              -fx-border-width: 0 0 2 0;">
                        <Label text="Delete(i) - O(log n)"
                               style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <Label text="(Use index above)"
                               style="-fx-font-size: 9; -fx-text-fill: #666;"/>
                        <Button text="Delete by Index" onAction="#deleteByIndex" maxWidth="Infinity"
                                style="-fx-background-color: #c0392b; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                    <!-- Clear -->
                    <VBox spacing="6" style="-fx-padding: 10;">
                        <Button text="Clear Heap" onAction="#clearHeap" maxWidth="Infinity"
                                style="-fx-background-color: #7f8c8d; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11;
                                       -fx-padding: 5;"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Right Side - Visualization -->
            <VBox spacing="0" HBox.hgrow="ALWAYS">

                <!-- Canvas Area (More Height) -->
                <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 10;">
                    <Canvas fx:id="heapCanvas" width="920" height="500"/>
                </StackPane>

                <!-- Array Representation (Improved) -->
                <VBox spacing="6" style="-fx-background-color: #ecf0f1; -fx-padding: 12;"
                      prefHeight="130">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Array Representation"
                               style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;"/>
                    </HBox>
                    <ScrollPane fitToHeight="true" prefHeight="95"
                                style="-fx-background: white; -fx-background-color: white;
                      -fx-border-color: #2c3e50; -fx-border-width: 2;">
                        <HBox fx:id="arrayBox" spacing="0" style="-fx-padding: 8; -fx-alignment: CENTER_LEFT;"/>
                    </ScrollPane>
                </VBox>

            </VBox>
        </HBox>
    </center>

    <!-- Bottom Control Bar (Compact) -->
    <bottom>
        <VBox spacing="0" style="-fx-background-color: #2c3e50;" prefHeight="80">

            <!-- Animation Controls -->
            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8;">

                <Label text="Speed:" textFill="white" style="-fx-font-weight: bold; -fx-font-size: 11;"/>

                <Label text="0.5x" textFill="#bdc3c7" style="-fx-font-size: 10;"/>
                <Slider fx:id="speedSlider" min="0.5" max="5" value="1.5"
                        prefWidth="150" showTickMarks="false"/>
                <Label text="5x" textFill="#bdc3c7" style="-fx-font-size: 10;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="playButton" text="▶ Play" onAction="#playAnimation"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 6 15; -fx-cursor: hand;
                               -fx-font-size: 11;"/>

                <Button fx:id="pauseButton" text="⏸ Pause" onAction="#pauseAnimation"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 6 15; -fx-cursor: hand;
                               -fx-font-size: 11;"/>

                <Button fx:id="stepButton" text="Step ▶" onAction="#nextStep"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 6 15; -fx-cursor: hand;
                               -fx-font-size: 11;"/>
            </HBox>

            <!-- Status Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color: #34495e; -fx-padding: 6 12;">
                <Label fx:id="statusLabel" text="Ready" textFill="white"
                       style="-fx-font-size: 12;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="complexityLabel" text="" textFill="#f39c12"
                       style="-fx-font-size: 11; -fx-font-weight: bold;"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>