<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.heap.heapController"
            style="-fx-background-color: #0f172a;"
            prefHeight="800" prefWidth="1200">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20;">
            <Button text="← Back" onAction="#backToDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Label text="Binary Heap Visualizer" textFill="white" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', sans-serif;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-border-width: 1;">
                <RadioButton fx:id="rbMaxHeap" text="Max Heap" textFill="white" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <RadioButton fx:id="rbMinHeap" text="Min Heap" textFill="white" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <left>
        <VBox style="-fx-padding: 0 0 20 20;">
            <!-- Left Operations Panel -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);" prefWidth="290" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" style="-fx-background: white; -fx-background-color: transparent; -fx-padding: 10; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="12" style="-fx-background-color: white;">

                        <!-- Create O(n log n) -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="Create(A) - O(n log n)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1e293b;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Size:" style="-fx-font-size: 12; -fx-text-fill: #475569; -fx-min-width: 40;"/>
                                <Spinner fx:id="sizeSpinner" prefWidth="70" editable="true"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Range:" style="-fx-font-size: 12; -fx-text-fill: #475569; -fx-min-width: 40;"/>
                                <Spinner fx:id="minSpinner" prefWidth="60" editable="true"/>
                                <Label text="-" style="-fx-text-fill: #475569;"/>
                                <Spinner fx:id="maxSpinner" prefWidth="60" editable="true"/>
                            </HBox>
                            <Button text="Generate Naive" onAction="#buildHeapNlogN" maxWidth="Infinity" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                        <!-- Create O(n) -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #f0fdf4; -fx-background-radius: 8; -fx-border-color: #bbf7d0; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="Create(A) - O(n)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #166534;"/>
                            <Label text="Optimal array-based heap construction" style="-fx-font-size: 11; -fx-text-fill: #15803d; -fx-wrap-text: true;"/>
                            <Button text="Generate Optimal" onAction="#buildHeapN" maxWidth="Infinity" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                        <!-- Insert -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="Insert(v) - O(log n)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1e293b;"/>
                            <TextField fx:id="valueInput" promptText="Enter value (e.g., 42)" style="-fx-padding: 8; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                            <Button text="Insert Value" onAction="#insertValue" maxWidth="Infinity" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                        <!-- Extract -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-border-color: #fecaca; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="Extract Root() - O(log n)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #991b1b;"/>
                            <Button text="Extract Min/Max" onAction="#extractRoot" maxWidth="Infinity" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                        <!-- Heap Sort -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #fdf4ff; -fx-background-radius: 8; -fx-border-color: #fbcfe8; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="HeapSort() - O(n log n)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #86198f;"/>
                            <Button text="Sort Array" onAction="#heapSort" maxWidth="Infinity" style="-fx-background-color: #d946ef; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                        <!-- Update Key -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #fffbeb; -fx-background-radius: 8; -fx-border-color: #fde68a; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="UpdateKey(i, newv) - O(log n)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #b45309;"/>
                            <HBox spacing="10">
                                <TextField fx:id="indexInput" promptText="Index" prefWidth="80" style="-fx-padding: 8; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                                <TextField fx:id="newValueInput" promptText="New Value" HBox.hgrow="ALWAYS" style="-fx-padding: 8; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                            </HBox>
                            <Button text="Update Key" onAction="#updateKey" maxWidth="Infinity" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                        <!-- Delete -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #fff1f2; -fx-background-radius: 8; -fx-border-color: #fecdd3; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="Delete(i) - O(log n)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #be123c;"/>
                            <Label text="(Uses Index from Update block above)" style="-fx-font-size: 11; -fx-text-fill: #881337;"/>
                            <Button text="Delete by Index" onAction="#deleteByIndex" maxWidth="Infinity" style="-fx-background-color: #f43f5e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                        <!-- Clear -->
                        <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-border-width: 1;">
                            <Button text="Clear Heap" onAction="#clearHeap" maxWidth="Infinity" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 6;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 0 20 20 20;">
            <!-- Tree Visualization -->
            <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4); -fx-padding: 15;">
                <Canvas fx:id="heapCanvas" width="850" height="420"/>
            </StackPane>

            <!-- Array Representation -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);" prefHeight="130">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Array Representation" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #1e293b;"/>
                </HBox>
                <ScrollPane fitToHeight="true" style="-fx-background: white; -fx-background-color: transparent; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10;" vbarPolicy="NEVER">
                    <HBox fx:id="arrayBox" spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white;"/>
                </ScrollPane>
            </VBox>

            <!-- Animation Controls -->
            <HBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 15 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                
                <Label text="Speed:" textFill="#475569" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <Label fx:id="speedLabel" text="1.5x" textFill="#0ea5e9" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <Slider fx:id="speedSlider" min="0.5" max="5" value="1.5" prefWidth="150" showTickMarks="false" style="-fx-cursor: hand;"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" text="Ready. Select an operation." textFill="#64748b" style="-fx-font-size: 14; -fx-font-style: italic; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="complexityLabel" text="" textFill="#eab308" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 0 15 0 0;"/>

                <Button fx:id="playButton" text="▶ Play" onAction="#playAnimation" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
                <Button fx:id="pauseButton" text="⏸ Pause" onAction="#pauseAnimation" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
                <Button fx:id="stepButton" text="Step ▶" onAction="#nextStep" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>