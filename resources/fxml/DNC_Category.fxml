<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="30.0"
      style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b); -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.AlgoVista.dnc.DNC_CategoryController">
    <children>
        
        <BorderPane>
            <left>
                <Button text="← Back" onAction="#backToDashboard"
                        style="-fx-background-color: rgba(56, 189, 248, 0.1);
                               -fx-text-fill: #38bdf8;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-padding: 8 20 8 20;
                               -fx-background-radius: 20;
                               -fx-border-radius: 20;
                               -fx-border-color: rgba(56, 189, 248, 0.5);
                               -fx-border-width: 1.5;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.2), 10, 0, 0, 2);"
                        BorderPane.alignment="CENTER" />
            </left>
            <center>
                <Label text="Divide &amp; Conquer" textFill="#38bdf8" BorderPane.alignment="CENTER">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </center>
            <right>
                <Button text="← Back" style="-fx-opacity: 0; -fx-font-size: 14; -fx-padding: 8 20 8 20; -fx-border-width: 1.5;" BorderPane.alignment="CENTER" />
            </right>
        </BorderPane>

        
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 10;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="cardContainer" alignment="CENTER" hgap="40.0" vgap="40.0" style="-fx-padding: 30;" />
            </content>
        </ScrollPane>
    </children>
</VBox>

