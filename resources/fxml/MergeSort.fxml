<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20.0"
      style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b); -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.AlgoVista.dnc.MergeSortController">
    <children>
        
        <BorderPane>
            <left>
                <Button text="← Back" onAction="#backToCategory"
                        style="-fx-background-color: rgba(155, 89, 182, 0.1);
                               -fx-text-fill: #9b59b2;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-padding: 8 20 8 20;
                               -fx-background-radius: 20;
                               -fx-border-color: rgba(155, 89, 182, 0.5);
                               -fx-cursor: hand;" />
            </left>
            <center>
                <Label text="Merge Sort" textFill="#9b59b2">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </center>
            <right>
                <HBox spacing="20" alignment="CENTER"
                      style="-fx-background-color: rgba(15, 23, 42, 0.8); -fx-padding: 6 18; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12; -fx-border-width: 1;">
                    <VBox fx:id="bestCaseBox" alignment="CENTER" spacing="2" style="-fx-padding: 2 5; -fx-background-radius: 5;">
                        <Label text="Best Time" textFill="#94a3b8" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                        <Label text="O(n log n)" textFill="#22c55e" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                    </VBox>
                    <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;"/>
                    <VBox fx:id="worstCaseBox" alignment="CENTER" spacing="2" style="-fx-padding: 2 5; -fx-background-radius: 5;">
                        <Label text="Worst Time" textFill="#94a3b8" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                        <Label text="O(n log n)" textFill="#ef4444" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                    </VBox>
                    <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;"/>
                    <VBox fx:id="spaceCaseBox" alignment="CENTER" spacing="2" style="-fx-padding: 2 5; -fx-background-radius: 5;">
                        <Label text="Space" textFill="#94a3b8" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                        <Label text="O(n)" textFill="#f59e0b" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </right>
        </BorderPane>

        
        <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox fx:id="treeContainer" alignment="CENTER" spacing="30.0" style="-fx-padding: 20;">
                
            </VBox>
        </ScrollPane>

        <VBox alignment="CENTER" spacing="5.0">
            <Label fx:id="statusLabel" text="Click Sort to start the visualization" textFill="#94a3b8">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </VBox>

        
        <HBox alignment="CENTER" spacing="25.0" style="-fx-background-color: rgba(30, 41, 59, 0.7); -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: rgba(155, 89, 182, 0.3);">
            <VBox spacing="8.0">
                <Label text="CUSTOM ARRAY (COMMA SEPARATED)" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10;" />
                <HBox spacing="10.0">
                    <TextField fx:id="customArrayInput" prefWidth="300.0" promptText="e.g. 5, 2, 8, 1, 9"
                               style="-fx-background-color: #334155; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 8;" />
                    <Button text="Create" onAction="#handleCustomArray"
                            style="-fx-background-color: linear-gradient(to bottom, #9b59b2, #8e44ad); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" />
                </HBox>
            </VBox>

            <VBox spacing="8.0" alignment="CENTER_LEFT">
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="SPEED:" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 10;" />
                    <Label fx:id="speedLabel" text="1.00x" textFill="#9b59b2" style="-fx-font-weight: bold; -fx-font-size: 10;" />
                </HBox>
                <Slider fx:id="speedSlider" min="0.25" max="2.0" value="1.0" prefWidth="120" style="-fx-cursor: hand;" />
            </VBox>
            
            <HBox alignment="BOTTOM_CENTER" spacing="15.0">
                <Button text="Start Merge Sort" onAction="#startSort"
                        style="-fx-background-color: linear-gradient(to bottom, #2ecc71, #27ae60); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 25;" />
                <Button text="Reset" onAction="#generateNewArray"
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-border-color: #ef4444; -fx-border-radius: 8; -fx-cursor: hand;" />
            </HBox>
        </HBox>
    </children>
</VBox>

