<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.TextFlow?>

<HBox fx:id="rootPane" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.AlgoVista.dp.KnapsackController">
    <children>
        <!-- Left Sidebar: The Shop -->
        <VBox prefWidth="250.0" spacing="15" style="-fx-background-color: #1e293b; -fx-padding: 15; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;">
            <children>
                <Label text="THE SHOP" textFill="#f59e0b" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                <Label text="Available Items:" textFill="#94a3b8" style="-fx-font-size: 12;"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="shopContainer" spacing="10" />
                    </content>
                </ScrollPane>
                <Separator style="-fx-opacity: 0.1;"/>
                <VBox spacing="10">
                    <Label text="Capacity (W):" textFill="#cbd5e1"/>
                    <TextField fx:id="inputCapacity" text="7" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-border-color: #334155;"/>
                    <Button text="Reset Items" onAction="#resetItems" maxWidth="Infinity" style="-fx-background-color: #334155; -fx-text-fill: white;"/>
                </VBox>
            </children>
        </VBox>

        <!-- Main Visualization Area: The DP Table -->
        <VBox HBox.hgrow="ALWAYS" spacing="20" style="-fx-padding: 20;">
            <children>
                <BorderPane>
                    <left>
                        <Button text="← Back" onAction="#backToCategory" 
                                style="-fx-background-color: rgba(56, 189, 248, 0.1); -fx-text-fill: #38bdf8; -fx-cursor: hand; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #38bdf8;"/>
                    </left>
                    <center>
                        <Label text="Knapsack: Value vs. Weight" textFill="#f59e0b">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                    </center>
                    <right>
                        <HBox spacing="20" alignment="CENTER"
                              style="-fx-background-color: rgba(15, 23, 42, 0.8); -fx-padding: 6 18; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12; -fx-border-width: 1;">
                            <VBox alignment="CENTER" spacing="2">
                                <Label text="Time Complexity" textFill="#94a3b8" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                                <Label text="O(N × W)" textFill="#22c55e" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                            </VBox>
                            <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;"/>
                            <VBox alignment="CENTER" spacing="2">
                                <Label text="Space Complexity" textFill="#94a3b8" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                                <Label text="O(N × W)" textFill="#ef4444" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                            </VBox>
                            <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;"/>
                            <VBox alignment="CENTER" spacing="2">
                                <Label text="Optimized Space" textFill="#94a3b8" style="-fx-font-size: 10; -fx-font-weight: bold;"/>
                                <Label text="O(W)" textFill="#f59e0b" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                    </right>
                </BorderPane>

                <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: rgba(30, 41, 59, 0.5); -fx-background-radius: 15;">
                    <children>
                        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <content>
                                <StackPane fx:id="tableStack" style="-fx-padding: 20;">
                                    <children>
                                        <GridPane fx:id="dpGrid" alignment="CENTER" hgap="2" vgap="2" />
                                        <Pane fx:id="ghostPane" mouseTransparent="true" />
                                    </children>
                                </StackPane>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>

                <!-- Status Area -->
                <HBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(245, 158, 11, 0.1); -fx-padding: 15; -fx-background-radius: 10;">
                    <children>
                        <Label fx:id="statusLabel" text="Maximum Value: 0" textFill="#f59e0b" style="-fx-font-weight: bold; -fx-font-size: 18;"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Right Sidebar: Controls & Code -->
        <VBox prefWidth="350.0" spacing="20" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-border-color: #334155; -fx-border-width: 0 0 0 1;">
            <children>
                <Label text="CONTROLS" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <HBox spacing="10">
                    <Button text="Start" onAction="#startVisualization" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10;"/>
                    <Button text="Step" onAction="#stepVisualization" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #38bdf8; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10;"/>
                </HBox>
                
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                         <Label text="Speed:" textFill="#cbd5e1" HBox.hgrow="ALWAYS"/>
                         <Label fx:id="speedLabel" text="1.0x" textFill="#f59e0b"/>
                    </HBox>
                    <Slider fx:id="speedSlider" min="0.1" max="3.0" value="1.0" />
                </VBox>

                <Separator style="-fx-opacity: 0.1;"/>

                <Label text="PSEUDO-CODE" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #0f172a; -fx-background-color: #0f172a; -fx-border-color: #334155;">
                    <content>
                        <TextFlow fx:id="pseudoCodeFlow" style="-fx-padding: 15;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</HBox>
