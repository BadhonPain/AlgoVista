<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.linkedlist.LinkedListMenuController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.5); -fx-padding: 15;">
            <Button text="← Back" onAction="#backToDashboard" styleClass="btn-primary" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30">
            <padding>
                <Insets top="10" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Linked List" textFill="#38bdf8">
                    <font>
                        <Font name="System Bold" size="42.0" />
                    </font>
                </Label>
            </VBox>

            <!-- Cards Container -->
            <HBox alignment="CENTER" spacing="40">
                
                <!-- Singly Linked List Card -->
                <VBox fx:id="singlyCard" onMouseClicked="#openSinglyLinkedList" prefWidth="320" prefHeight="260"
                      style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);">
                    <VBox style="-fx-background-image: url('@../com/AlgoVista/images/sll.png'); -fx-background-size: cover; -fx-background-position: center; -fx-background-radius: 15 15 0 0;" VBox.vgrow="ALWAYS"/>
                    <VBox alignment="CENTER" prefHeight="70" style="-fx-padding: 10;">
                        <Label text="Singly Linked List" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 22;" />
                    </VBox>
                </VBox>

                <!-- Doubly Linked List Card -->
                <VBox fx:id="doublyCard" onMouseClicked="#openDoublyLinkedList" prefWidth="320" prefHeight="260"
                      style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);">
                    <VBox style="-fx-background-image: url('@../com/AlgoVista/images/dll.png'); -fx-background-size: cover; -fx-background-position: center; -fx-background-radius: 15 15 0 0;" VBox.vgrow="ALWAYS"/>
                    <VBox alignment="CENTER" prefHeight="70" style="-fx-padding: 10;">
                        <Label text="Doubly Linked List" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 22;" />
                    </VBox>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
