<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.linkedlist.LinkedListMenuController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.5); -fx-padding: 15;">
            <Button text="← Back to Dashboard" onAction="#backToDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; 
                           -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14;" />
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="40">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Linked Lists Visualizers" textFill="#38bdf8">
                    <font>
                        <Font name="System Bold" size="42.0" />
                    </font>
                </Label>
                <Label text="Explore the different types of linked lists and how they work." textFill="#94a3b8">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </VBox>

            <!-- Cards Container -->
            <HBox alignment="CENTER" spacing="40">
                
                <!-- Singly Linked List Card -->
                <VBox fx:id="singlyCard" alignment="CENTER" spacing="20" prefWidth="300" prefHeight="350"
                      onMouseClicked="#openSinglyLinkedList"
                      style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 15; 
                             -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                    <padding>
                        <Insets top="30" right="20" bottom="30" left="20"/>
                    </padding>
                    <!-- Simple visual representation -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="[10|•]" textFill="#38bdf8" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
                        <Label text="→" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
                        <Label text="[20|•]" textFill="#38bdf8" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
                        <Label text="→" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
                        <Label text="null" textFill="#e2e8f0" style="-fx-font-size: 18;"/>
                    </HBox>
                    <Label text="Singly Linked List" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 22;" />
                    <Label text="Nodes contain data and a pointer to the next node." 
                           textFill="#94a3b8" wrapText="true" textAlignment="CENTER" style="-fx-font-size: 14;"/>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </VBox>

                <!-- Doubly Linked List Card -->
                <VBox fx:id="doublyCard" alignment="CENTER" spacing="20" prefWidth="300" prefHeight="350"
                      onMouseClicked="#openDoublyLinkedList"
                      style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 15;
                             -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                    <padding>
                        <Insets top="30" right="20" bottom="30" left="20"/>
                    </padding>
                    <!-- Simple visual representation -->
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="null ←" textFill="#e2e8f0" style="-fx-font-size: 18;"/>
                        <Label text="[•|10|•]" textFill="#38bdf8" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
                        <Label text="↔" textFill="#94a3b8" style="-fx-font-weight: bold; -fx-font-size: 24;"/>
                        <Label text="[•|20|•]" textFill="#38bdf8" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
                        <Label text="→ null" textFill="#e2e8f0" style="-fx-font-size: 18;"/>
                    </HBox>
                    <Label text="Doubly Linked List" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 22;" />
                    <Label text="Nodes contain data and pointers to previous and next nodes." 
                           textFill="#94a3b8" wrapText="true" textAlignment="CENTER" style="-fx-font-size: 14;"/>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
