<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="30.0"
      style="-fx-background-color: linear-gradient(to bottom right, #f8fafc, #e2e8f0); -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.AlgoVista.trees.TreeTraversalsCategoryController">
    <children>
        <!-- Top Bar with Back Button and Header -->
        <BorderPane>
            <left>
                <Button text="← Back" onAction="#backToDashboard"
                        style="-fx-background-color: rgba(15, 23, 42, 0.05);
                               -fx-text-fill: #0f172a;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-padding: 8 20 8 20;
                               -fx-background-radius: 20;
                               -fx-border-radius: 20;
                               -fx-border-color: rgba(15, 23, 42, 0.3);
                               -fx-border-width: 1.5;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.1), 5, 0, 0, 1);"
                        BorderPane.alignment="CENTER" />
            </left>
            <center>
                <Label text="Tree Traversals" textFill="#0f172a" BorderPane.alignment="CENTER">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </center>
            <right>
                <!-- Invisible dummy button to perfectly center the title -->
                <Button text="← Back" style="-fx-opacity: 0; -fx-font-size: 14; -fx-padding: 8 20 8 20; -fx-border-width: 1.5;" BorderPane.alignment="CENTER" />
            </right>
        </BorderPane>

        <!-- Cards Container -->
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 10;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="cardContainer" alignment="CENTER" hgap="40.0" vgap="40.0" style="-fx-padding: 30;" />
            </content>
        </ScrollPane>
    </children>
</VBox>
