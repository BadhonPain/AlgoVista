<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.AlgoVista.graphs.TopologicalSortController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- ═══ TOP BAR ═══ -->
    <top>
        <VBox style="-fx-background-color: #1e293b;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10 16;">
                <Button text="&#8592; Back" onAction="#backToCategory"
                        style="-fx-background-color: rgba(14, 165, 233, 0.12);
                               -fx-text-fill: #0ea5e9; -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-padding: 7 18; -fx-background-radius: 20; -fx-border-radius: 20;
                               -fx-border-color: rgba(14, 165, 233, 0.45); -fx-border-width: 1.5;
                               -fx-cursor: hand;"/>
                <Label text="Topological Sort  (Kahn's Algorithm)" textFill="#0ea5e9">
                    <font><Font name="System Bold" size="21"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="20" alignment="CENTER"
                      style="-fx-background-color: #0f172a; -fx-padding: 6 14; -fx-background-radius: 8;">
                    <Label text="Time: O(V + E)" textFill="#22c55e" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                    <Separator orientation="VERTICAL" style="-fx-background-color: #334155;"/>
                    <Label text="Space: O(V)" textFill="#f59e0b" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>

            <!-- Controls -->
            <HBox spacing="14" alignment="CENTER_LEFT"
                  style="-fx-padding: 8 16; -fx-background-color: #0f172a;">

                <!-- Speed -->
                <VBox spacing="3">
                    <Label text="Animation Speed" textFill="#64748b" style="-fx-font-size: 10;"/>
                    <HBox spacing="5" alignment="CENTER">
                        <Label text="Slow" textFill="#475569" style="-fx-font-size: 10;"/>
                        <Slider fx:id="speedSlider" min="200" max="2000" value="900" prefWidth="100"/>
                        <Label text="Fast" textFill="#475569" style="-fx-font-size: 10;"/>
                    </HBox>
                </VBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #334155;"/>

                <!-- Playback Buttons -->
                <HBox spacing="6">
                    <Button fx:id="playButton" text="&#9654;  Run" onAction="#runSort"
                            style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 7 16; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12;"/>
                    <Button fx:id="stepButton" text="Step  &#10095;" onAction="#stepForward"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 7 16; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12;"/>
                    <Button fx:id="resetButton" text="&#8635;  Reset" onAction="#resetSort"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 7 16; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12;"/>
                </HBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #334155;"/>

                <!-- Graph Generation -->
                <VBox spacing="3">
                    <Label text="Generate DAG" textFill="#64748b" style="-fx-font-size: 10;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Nodes:" textFill="#94a3b8" style="-fx-font-size: 11;"/>
                        <Spinner fx:id="nodesSpinner" prefWidth="55" editable="true"/>
                        <Label text="Edges:" textFill="#94a3b8" style="-fx-font-size: 11;"/>
                        <Spinner fx:id="edgesSpinner" prefWidth="55" editable="true"/>
                        <Button text="&#8635; Random DAG" onAction="#generateRandomGraph"
                                style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8;
                                       -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 11;"/>
                        <Button text="Default" onAction="#loadDefaultGraph"
                                style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 8;
                                       -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 11;"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Cycle detection badge -->
                <Label fx:id="cycleLabel" text="" textFill="#ef4444"
                       style="-fx-font-size: 12; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ═══ CENTER BODY ═══ -->
    <center>
        <HBox spacing="12" style="-fx-padding: 12 12 12 2;" VBox.vgrow="ALWAYS">

            <!-- LEFT: Graph Canvas -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="&#127760;  Directed Acyclic Graph (DAG)" textFill="#94a3b8"
                       style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                <StackPane VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #0a0f1e; -fx-background-radius: 12;
                                  -fx-border-color: #1e3a5f; -fx-border-width: 1.5; -fx-border-radius: 12;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 14, 0, 0, 3);">
                    <Canvas fx:id="graphCanvas" width="580" height="450"/>
                </StackPane>

                <!-- Legend -->
                <HBox spacing="20" alignment="CENTER"
                      style="-fx-background-color: #1e293b; -fx-padding: 8 20; -fx-background-radius: 8;">
                    <HBox spacing="6" alignment="CENTER">
                        <Region style="-fx-background-color: #475569; -fx-pref-width: 14; -fx-pref-height: 14; -fx-background-radius: 7;"/>
                        <Label text="Unprocessed" textFill="#94a3b8" style="-fx-font-size: 11;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Region style="-fx-background-color: #fbbf24; -fx-pref-width: 14; -fx-pref-height: 14; -fx-background-radius: 7;"/>
                        <Label text="In Queue" textFill="#94a3b8" style="-fx-font-size: 11;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Region style="-fx-background-color: #0ea5e9; -fx-pref-width: 14; -fx-pref-height: 14; -fx-background-radius: 7;"/>
                        <Label text="Processing" textFill="#94a3b8" style="-fx-font-size: 11;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Region style="-fx-background-color: #22c55e; -fx-pref-width: 14; -fx-pref-height: 14; -fx-background-radius: 7;"/>
                        <Label text="Done" textFill="#94a3b8" style="-fx-font-size: 11;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER">
                        <Label text="In-deg: 0" textFill="#f43f5e" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                        <Label text="= source node" textFill="#94a3b8" style="-fx-font-size: 11;"/>
                    </HBox>
                </HBox>
            </VBox>

            <!-- RIGHT: Queue + Code + Output -->
            <VBox spacing="10" prefWidth="380" VBox.vgrow="ALWAYS">

                <!-- ① Queue + In-degree panel (side by side) -->
                <HBox spacing="8" prefHeight="270">

                    <!-- BFS Queue -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #1e293b; -fx-padding: 12; -fx-background-radius: 10;
                                 -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="&#9710;" textFill="#fbbf24" style="-fx-font-size: 13;"/>
                            <Label text="Zero In-degree Queue" textFill="#fbbf24"
                                   style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="queueSizeLabel" text="Size: 0" textFill="#475569"
                                   style="-fx-font-size: 10; -fx-background-color: #0f172a;
                                          -fx-padding: 2 8; -fx-background-radius: 10;"/>
                        </HBox>
                        <Separator style="-fx-background-color: #334155;"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-background: transparent; -fx-background-color: transparent;
                                           -fx-border-color: transparent;">
                            <VBox fx:id="queueContainer" spacing="5" alignment="TOP_CENTER"
                                  style="-fx-padding: 4;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- In-Degree Table -->
                    <VBox spacing="6" prefWidth="130"
                          style="-fx-background-color: #1e293b; -fx-padding: 12; -fx-background-radius: 10;
                                 -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10;">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="In-degree" textFill="#0ea5e9"
                                   style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                        </HBox>
                        <Separator style="-fx-background-color: #334155;"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-background: transparent; -fx-background-color: transparent;
                                           -fx-border-color: transparent;">
                            <VBox fx:id="inDegreeContainer" spacing="3" alignment="TOP_CENTER"
                                  style="-fx-padding: 2;"/>
                        </ScrollPane>
                    </VBox>

                </HBox>

                <!-- ② Python Code Panel -->
                <VBox spacing="6" prefHeight="165"
                      style="-fx-background-color: #1e293b; -fx-padding: 12; -fx-background-radius: 10;
                             -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="&#128196;" style="-fx-font-size: 13;"/>
                        <Label text="Python Code" textFill="#38bdf8"
                               style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Kahn's BFS Algorithm" textFill="#475569" style="-fx-font-size: 10;"/>
                    </HBox>
                    <Separator style="-fx-background-color: #334155;"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background: transparent; -fx-background-color: transparent;
                                       -fx-border-color: transparent;">
                        <VBox fx:id="codeContainer" spacing="0"
                              style="-fx-background-color: #0a0f1e; -fx-padding: 10; -fx-background-radius: 8;"/>
                    </ScrollPane>
                </VBox>

                <!-- ③ Topological Order Output -->
                <VBox spacing="6" prefHeight="155"
                      style="-fx-background-color: #1e293b; -fx-padding: 12; -fx-background-radius: 10;
                             -fx-border-color: #1e3a5f; -fx-border-width: 1; -fx-border-radius: 10;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="&#9654;" textFill="#22c55e" style="-fx-font-size: 12;"/>
                        <Label text="Topological Order" textFill="#22c55e"
                               style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                    </HBox>
                    <Separator style="-fx-background-color: #334155;"/>
                    <TextArea fx:id="consoleArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                              style="-fx-control-inner-background: #0a0f1e;
                                     -fx-text-fill: #22c55e;
                                     -fx-font-family: 'Consolas';
                                     -fx-font-size: 12px;
                                     -fx-background-radius: 8;
                                     -fx-focus-color: transparent;
                                     -fx-faint-focus-color: transparent;"/>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
